{
  "name": "sdet-typescript-foundations",
  "version": "1.0.0",
  "description": "Stage 4 – TypeScript foundations for SDET and Playwright",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/playground.ts",
    "build": "tsc",
    "start": "node dist/playground.js",
    "clean": "rm -rf dist",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "expect": "^30.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
